# Copy to .env (same folder as wb2api-model-failover.py) and fill in.
# .env is git-ignored; never commit real keys.

# Upstream WB2api-Hub gateway (the address your hub is published on).
WB2API_TARGET=http://YOUR_SERVER_IP:7863

# Gateway API key. If you left API_KEY empty at deploy time, it was auto
# generated and written to accounts/settings.json ("launcher_key").
WB2API_KEY=wb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local listen address (optional; defaults shown).
FAILOVER_LISTEN_HOST=127.0.0.1
FAILOVER_LISTEN_PORT=8799
